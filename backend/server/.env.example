# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/cinema_db

# JWT Configuration  
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Configuration
# Khong hard-code API Secret trong source code. Dien API Secret o file .env local/deploy.
CLOUDINARY_CLOUD_NAME=dvayorxdv
CLOUDINARY_API_KEY=583251364464214
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# VNPay Sandbox Configuration
# Đăng ký tại: https://sandbox.vnpayment.vn/
# Tài liệu: https://sandbox.vnpayment.vn/apis/docs/

# Mã định danh Merchant (lấy từ Dashboard VNPay)
VNPAY_TMN_CODE=CGXZLS0Z

# Khóa bí mật để tạo/xác thực chữ ký (lấy từ Dashboard VNPay)
VNPAY_HASH_SECRET=KQWNVCXOVLASATQZWCSSXNJYRQFHJQFZ

# URL cổng thanh toán VNPay
# Sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Production: https://pay.vnpay.vn/vpcpay.html
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# URL VNPay sẽ redirect về sau khi thanh toán
# Đây là URL frontend của bạn
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

# URL VNPay gọi server-to-server (IPN)
# Cần public URL khi deploy (có thể dùng ngrok khi dev)
VNPAY_IPN_URL=http://localhost:4000/payments/vnpay-ipn

