# 2. Thay VNPAY_TMN_CODE và VNPAY_HASH_SECRET
# 3. Đổi VNPAY_URL sang https://pay.vnpay.vn/vpcpay.html
# 4. Cập nhật VNPAY_RETURN_URL và VNPAY_IPN_URL sang domain thật
# 5. Đảm bảo IPN URL có thể truy cập public
# ===========================================

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="Cinema Booking" <your_email@gmail.com>

# Frontend URL
FRONTEND_URL=http://localhost:3000
RESEND_EMAIL_COOLDOWN_SECONDS=60

